<%
const gbp = (n) => '£' + Number(n || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const payable = (verification.lines || []).filter(l => l.ok);
const blocked = (verification.lines || []).filter(l => !l.ok);
%>
<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">

  <div class="flex items-center gap-3 mb-6">
    <a href="/payments/bulk" class="text-sm text-green-700 dark:text-green-400 hover:underline">&larr; Back to selection</a>
    <span class="text-gray-400">/</span>
    <h1 class="text-2xl font-bold">Confirm bulk payment</h1>
  </div>

  <% if (blocked.length) { %>
    <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-900/30 dark:border-amber-700 p-4">
      <p class="text-sm font-semibold text-amber-800 dark:text-amber-300 mb-2">
        <%= blocked.length %> line(s) can’t be paid and have been excluded:
      </p>
      <ul class="text-sm text-amber-800 dark:text-amber-300 list-disc pl-5 space-y-0.5">
        <% blocked.forEach(l => { %><li>Invoice #<%= l.number %> — <%= l.problem %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Summary -->
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-5 mb-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div><div class="text-gray-500 dark:text-gray-400">Pay from</div><div class="font-medium mt-0.5"><%= account.AccountName %></div></div>
      <div><div class="text-gray-500 dark:text-gray-400">Date</div><div class="font-medium mt-0.5"><%= date %></div></div>
      <div><div class="text-gray-500 dark:text-gray-400">Method</div><div class="font-medium mt-0.5">Code <%= method %></div></div>
      <div><div class="text-gray-500 dark:text-gray-400">Invoices</div><div class="font-medium mt-0.5"><%= payable.length %></div></div>
    </div>
    <% if (comment) { %><div class="mt-3 text-sm"><span class="text-gray-500 dark:text-gray-400">Comment:</span> <%= comment %></div><% } %>
  </div>

  <% if (!payable.length) { %>
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-8 text-center text-gray-500 dark:text-gray-400">
      Nothing left to pay. <a href="/payments/bulk" class="text-green-700 dark:text-green-400 hover:underline">Return to selection</a>.
    </div>
  <% } else { %>

  <div class="overflow-x-auto bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm mb-4">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400">
        <tr>
          <th class="px-3 py-2 text-left">Invoice</th>
          <th class="px-3 py-2 text-left">Supplier</th>
          <th class="px-3 py-2 text-right">Due (live)</th>
          <th class="px-3 py-2 text-right">Paying</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        <% payable.forEach(l => { %>
          <tr>
            <td class="px-3 py-2 font-medium">#<%= l.number %></td>
            <td class="px-3 py-2"><%= l.supplierName || '—' %></td>
            <td class="px-3 py-2 text-right text-gray-500"><%= gbp(l.liveDueAmount) %></td>
            <td class="px-3 py-2 text-right font-semibold"><%= gbp(l.requestedAmount) %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot class="bg-gray-50 dark:bg-gray-800">
        <tr>
          <td colspan="3" class="px-3 py-2 text-right font-semibold">Total</td>
          <td class="px-3 py-2 text-right font-bold"><%= gbp(verification.total) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <form method="POST" action="/payments/bulk/confirm" class="flex items-center justify-between">
    <%- include('../partials/csrfHidden') %>
    <input type="hidden" name="accountId" value="<%= accountId %>" />
    <input type="hidden" name="method" value="<%= method %>" />
    <input type="hidden" name="date" value="<%= date %>" />
    <input type="hidden" name="comment" value="<%= comment %>" />
    <% payable.forEach(l => { %>
      <input type="hidden" name="selected" value="<%= l.number %>" />
      <input type="hidden" name="number" value="<%= l.number %>" />
      <input type="hidden" name="amount" value="<%= Number(l.requestedAmount).toFixed(2) %>" />
    <% }); %>

    <a href="/payments/bulk" class="text-sm px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800">Cancel</a>
    <button type="submit"
            class="text-sm font-semibold px-6 py-2.5 rounded-lg bg-green-600 text-white hover:bg-green-500">
      Pay <%= gbp(verification.total) %> now
    </button>
  </form>
  <p class="text-[11px] text-gray-400 mt-3">
    This records the payment in KashFlow immediately. Amounts are re-checked once more against the live ledger at the moment you press Pay.
  </p>
  <% } %>
</div>
